{
  "name": "half-sour",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "node lib/demo/scripts/build-image.mts",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test --project=chromium --project=admin e2e/a11y.spec.ts e2e/a11y-admin.spec.ts",
    "lhci": "lhci autorun",
    "auth:hash-password": "node lib/auth/scripts/hash-password.mts",
    "auth:new-session-secret": "node lib/auth/scripts/new-session-secret.mts",
    "auth:unlock": "node lib/auth/scripts/unlock.mts",
    "demo:build-image": "node lib/demo/scripts/build-image.mts --force"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.16",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@supabase/supabase-js": "^2.112.4",
    "gsap": "^3.15.0",
    "hash-wasm": "^4.12.0",
    "lenis": "^1.3.26",
    "leva": "^0.10.1",
    "next": "16.3.3",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "three": "^0.185.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@types/three": "^0.185.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.3",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
