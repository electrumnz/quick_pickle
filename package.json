{
  "name": "quick-pickle",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "audit:copy": "node legal/scripts/audit-copy.mjs app components content lib public",
    "audit:copy:selftest": "node legal/scripts/test-audit.mjs",
    "db:generate": "drizzle-kit generate && node scripts/embed-migrations.mjs",
    "db:check": "node scripts/embed-migrations.mjs --check",
    "prelaunch": "node scripts/prelaunch.mts",
    "lhci": "lhci autorun"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.16",
    "drizzle-orm": "0.45.4",
    "hash-wasm": "4.12.0",
    "next": "16.3.3",
    "pg": "8.23.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.3",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
