# ---------------------------------------------------------------------------
# HALF SOUR — environment variables
#
# Copy to `.env.local` and fill in. NEVER commit real values: `.env` / `.env.*`
# are gitignored and this example file is the single opt-in exception.
# In production these are set as Vercel Project Environment Variables.
# ---------------------------------------------------------------------------

# --- Site -----------------------------------------------------------------
# Canonical public origin, no trailing slash (e.g. https://halfsour.co.nz)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Demo mode ------------------------------------------------------------
# Set to exactly "1" to serve the whole site — storefront, shop and admin —
# from a Postgres image compiled into the build, with no external database.
# See lib/demo/README.md. Unset, absolutely nothing changes.
#
# It supplies a DATABASE and nothing else. ADMIN_PASSWORD_HASH and
# ADMIN_SESSION_SECRET are still required to sign in, a wrong password is still
# refused, and every page carries a banner saying the data is invented and
# resets. Anything served this way is noindex, three ways over.
#
# It must be set at BUILD time as well as run time: the image is built by the
# `prebuild` script, and the noindex layers are decided in the build.
#
# Deliberately commented out: copying this file must not switch demo mode on.
# HALF_SOUR_DEMO=1

# --- Commerce adapter -----------------------------------------------------
# Which commerce backend lib/commerce talks to: "shopify" | "mock"
# Use "mock" for local dev and CI so no Shopify credentials are required.
# Leave it unset when HALF_SOUR_DEMO=1 and it resolves to the demo provider;
# unset without demo mode it throws, which is deliberate.
COMMERCE_PROVIDER=mock

# --- Shopify --------------------------------------------------------------
# Store domain, e.g. your-store.myshopify.com. Not a secret, but the real
# value is a deployment detail: it lives in the Vercel project environment
# variables (all targets) and in your local .env.local, never in this file.
SHOPIFY_STORE_DOMAIN=
# Storefront API public access token — read-only, used for catalogue + cart
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
# Admin API access token (shpat_...) — SERVER ONLY, full read/write access
SHOPIFY_ADMIN_ACCESS_TOKEN=
# Shopify API version pinned by both clients, e.g. 2026-07
SHOPIFY_API_VERSION=
# Shared secret used to verify inbound Shopify webhook HMAC signatures
SHOPIFY_WEBHOOK_SECRET=

# Store defaults (not secrets) — currency NZD, timezone Pacific/Auckland
NEXT_PUBLIC_STORE_CURRENCY=NZD
NEXT_PUBLIC_STORE_TIMEZONE=Pacific/Auckland

# --- Supabase -------------------------------------------------------------
# Project REST URL, e.g. https://abcdefghijklm.supabase.co (browser-safe)
NEXT_PUBLIC_SUPABASE_URL=
# Publishable / anon key — browser-safe, protected by row level security
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — SERVER ONLY, bypasses RLS. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection string, used by migrations and seed scripts
SUPABASE_DB_URL=

# --- Models: the Vercel AI Gateway ----------------------------------------
# The eight agent roles in lib/agents/roster call their models through the
# Vercel AI Gateway. One endpoint in front of every provider, so which model a
# role runs on is an environment variable rather than a code change.
#
# Key minted at vercel.com/<team>/~/ai/api-keys. SERVER ONLY.
# On Vercel itself this can be left EMPTY: the platform mints VERCEL_OIDC_TOKEN
# for the deployment and the gateway provider reads it without being told to.
# With neither, nothing breaks — the site, the shop and the admin all work, and
# every agent run stops at its first model call and records why.
AI_GATEWAY_API_KEY=
# Optional. Override the gateway endpoint. Leave unset.
AI_GATEWAY_BASE_URL=
#
# ⚠ THE DEFAULT MODELS ARE FREE ONLY UNTIL SUNDAY 6 SEPTEMBER 2026.
#
# minimax/minimax-m3-free and minimax/minimax-m2.7-free bill at zero on the AI
# Gateway via GMI Cloud through that date, after which the ids stop serving.
# See vercel.com/changelog/minimax-m3-and-m2-7-are-free-on-ai-gateway.
#
# The code carries that date as one constant in lib/agents/model/roster-models.ts
# and FAILS CLOSED past it: it refuses to call a free-tier id rather than
# rolling silently onto tokens nobody approved, the admin says so in a banner,
# and every run halts with the reason on the record. Losing agent output is a
# nuisance; an unattended bill is not.
#
# To resume after that date, name a model you have chosen to pay for. The
# override wins before and after the date — the cutoff stops an accident, it
# does not overrule a decision.
#   minimax/minimax-m3    is the paid twin of the default, USD 0.30/1.20 per M
HALF_SOUR_AGENT_MODEL=
# Per-role override, which beats the global one. Slug uppercased, dashes to
# underscores. The eight are BRINE_OPS, CONCIERGE, LEDGER, SOCIAL, MARKETING,
# TRADE, PRODUCT, ANALYST.
#   HALF_SOUR_AGENT_MODEL_CONCIERGE=minimax/minimax-m3
#
# Data flow. These prompts contain what customers and wholesale accounts wrote.
# The gateway can refuse to route to a provider that trains on prompt data, or
# retains it — but the free MiniMax ids are served by neither kind, so turning
# either filter on while they are the model leaves nothing able to answer.
# Set these together with a paid model id, not on their own. "1" turns them on.
AI_GATEWAY_DISALLOW_PROMPT_TRAINING=
AI_GATEWAY_ZERO_DATA_RETENTION=

# --- Anthropic (the alternative backend) ----------------------------------
# Used only when no gateway credential is present. API key (sk-ant-...) for the
# agent layer in lib/agents — SERVER ONLY
ANTHROPIC_API_KEY=
# Optional model override, e.g. claude-opus-4-5
ANTHROPIC_MODEL=

# --- Inngest --------------------------------------------------------------
# Event key used to send events to Inngest — SERVER ONLY
INNGEST_EVENT_KEY=
# Signing key used to verify inbound requests from Inngest — SERVER ONLY
INNGEST_SIGNING_KEY=

# --- Admin auth -----------------------------------------------------------
# See lib/auth/README.md. The admin gate fails closed: if any of the three
# required values below is missing, sign-in is refused rather than degraded.
#
# argon2id PHC string for the admin password, e.g.
#   $argon2id$v=19$m=19456,t=2,p=1$<salt>$<digest>
# Generate with `npm run auth:hash-password` (prompts with echo off, or reads
# stdin). Store the HASH only: the plaintext belongs in a password manager and
# nowhere else, and the hash is deliberately NOT kept in the database so that a
# database dump contains nothing crackable.
#
# QUOTE IT. A PHC string is mostly dollar signs, which makes it the worst
# possible shape to put through anything that expands variables. Unquoted, a
# shell or a `.env` loader eats `$argon2id`, `$v` and `$m` as empty variables
# and leaves only the parameter tail — and the gate then reads a valid password
# as a wrong one, with nothing to say why. Single quotes, always:
#
#   ADMIN_PASSWORD_HASH='$argon2id$v=19$m=19456,t=2,p=1$<salt>$<digest>'
#
# Pasting into a hosting dashboard is safe; that does no expansion. Defining the
# key in two files is not — the second definition wins and can arrive mangled.
# The sign-in page detects this case by name and says so.
ADMIN_PASSWORD_HASH=
# Root key the admin session and CSRF cookies are sealed under. 32+ random
# bytes, base64. Generate with `npm run auth:new-session-secret`.
# Rotating this signs everyone out immediately — the emergency lever behind
# per-session revocation.
ADMIN_SESSION_SECRET=
# Optional. Identity recorded on the founder's `operators` row, which is created
# on first successful sign-in and is what `admin_sessions` rows hang off.
ADMIN_OPERATOR_EMAIL=
ADMIN_OPERATOR_NAME=
# Optional. Whether to believe X-Forwarded-For when identifying the client for
# the per-IP rate limit. Defaults to true in production and on Vercel, where the
# edge rewrites those headers. "false" anywhere the app is exposed directly.
ADMIN_TRUST_PROXY_HEADERS=

# --- Social platforms: the seam, declared, with nothing behind it ----------
#
# READ THIS FIRST. Setting every variable below changes nothing. There is no
# publisher in this codebase: no OAuth flow, no token exchange, no call to any
# platform API, and no code path from the admin to a network. Every approved
# action ends in the outbox with `delivered: false`, and the Social page says so
# on every control. These names exist so that the day somebody writes the
# publisher, the shape of what it needs is already agreed and reviewed, rather
# than being invented in a hurry by whoever is holding the credential.
#
# `app/(admin)/admin/social` renders a PREVIEW — an approximation of each
# platform's layout with that platform's real limits enforced. It needs none of
# these values and works without them; the limits are compiled in, with their
# sources, in lib/social/platforms.ts.
#
# WHERE THE TOKEN GOES. Not here. `public.social_accounts.credential_ref` is a
# pointer into Supabase Vault, and the migration says so in a comment: an access
# token is never stored in a public-schema column. What belongs in the
# environment is the APP's identity — the client id and secret the app itself
# is registered under — not a token minted for one account.

# Meta Graph API — covers BOTH Instagram and Facebook. One app, one review.
# App id and secret from developers.facebook.com → My Apps → your app →
# Settings → Basic. The app needs Facebook Login for Business and the
# `instagram_content_publish`, `pages_manage_posts` and `pages_read_engagement`
# permissions, and Meta must have approved them in App Review before any
# account other than a developer's own will connect.
META_APP_ID=
META_APP_SECRET=
# Graph API version to pin, e.g. v23.0. Meta deprecates a version roughly every
# two years and an unpinned client breaks on their schedule, not ours.
META_GRAPH_API_VERSION=
# The Instagram professional account's id, from
# GET /me/accounts?fields=instagram_business_account on a page token. Not the
# handle: the handle can be changed by its owner and the id cannot.
META_INSTAGRAM_ACCOUNT_ID=
# The Facebook Page id posts would go to, from GET /me/accounts.
META_FACEBOOK_PAGE_ID=

# X (formerly Twitter). App created at developer.x.com under a project on a
# paid access tier — the free tier cannot post on behalf of a user. OAuth 2.0
# client id and secret from the app's "Keys and tokens" tab; posting needs the
# `tweet.write`, `tweet.read` and `users.read` scopes.
X_CLIENT_ID=
X_CLIENT_SECRET=

# LinkedIn. App created at linkedin.com/developers, associated with the HALF
# SOUR Page, and granted the "Community Management API" product — which is
# request-and-review, not self-serve. Client id and secret from the app's Auth
# tab; posting as the company needs `w_organization_social`.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# The organisation the post is authored by, as a URN, e.g. urn:li:organization:12345.
# From GET /rest/organizationAcls?q=roleAssignee.
LINKEDIN_ORGANIZATION_URN=

# Where every one of the three sends the browser back after consent. Must match
# the value registered with each platform character for character, including the
# scheme and any trailing slash. There is no route at this path today.
SOCIAL_OAUTH_REDIRECT_URI=
