# ---------------------------------------------------------------------------
# QUICK PICKLE: environment variables
#
# Copy to `.env.local` and fill in. NEVER commit real values: `.env` / `.env.*`
# are gitignored and this example file is the single opt-in exception.
# In production these are Vercel Project Environment Variables.
#
# Nothing here is required to run the site. With every line unset it builds,
# serves, takes test orders, charges nobody, and runs its back end on demo
# data in memory.
# ---------------------------------------------------------------------------

# Canonical public origin, no trailing slash (e.g. https://quickpickle.co.nz).
# Unset, it falls back to the Vercel domain, then to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Which payment processor the checkout uses. "test" (the default) records the
# order and moves no money, and every checkout screen says so. A real
# processor is added in lib/shop/payments/index.ts; an unknown name here is a
# hard failure, never a silent fall back to test mode.
PAYMENT_PROVIDER=test

# Where the shop hands orders and Pickle Crew sign-ups over.
#   db    the default: the back end's database, through its own operations.
#   file  appends JSON lines under .data/ (gitignored).
#   log   one structured line to the server log, nothing kept.
ORDER_STORE=

# --- The database -----------------------------------------------------------
# A Postgres connection string. In production this is Supabase's transaction
# pooler URI. POSTGRES_URL (what the Vercel and Supabase integration writes) is
# read too. With neither set the app runs on Postgres in the same process
# (PGlite): in memory for tests and deployments, under .data/pglite in
# development, and the back end runs in demo mode.
DATABASE_URL=

# The database provider's CA certificate (PEM). With it the server is verified
# properly; without it the link is encrypted but the server is not proven.
DATABASE_CA_CERT=

# A Vercel preview deployment ignores the database unless this is "1".
# Previews run unmerged code and take test orders. Leave it unset.
QP_PREVIEW_DATABASE=

# "memory" keeps the in-process database in memory even in development.
# The browser tests use it.
QP_EMBEDDED_DB=

# --- The back end -----------------------------------------------------------
# A phrase of 16 characters or more. It is typed once, on /backstage/set-up,
# to create the first owner. After that it does nothing.
BACKSTAGE_SETUP_CODE=

# "required" makes the in-process database behave as a real one: sign-in is
# enforced. For tests and for trying the sign-in screens locally.
BACKSTAGE_AUTH=
