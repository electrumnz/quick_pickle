# ---------------------------------------------------------------------------
# HALF SOUR — environment variables
#
# Copy to `.env.local` and fill in. NEVER commit real values: `.env` / `.env.*`
# are gitignored and this example file is the single opt-in exception.
# In production these are set as Vercel Project Environment Variables.
# ---------------------------------------------------------------------------

# --- Site -----------------------------------------------------------------
# Canonical public origin, no trailing slash (e.g. https://halfsour.co.nz)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Commerce adapter -----------------------------------------------------
# Which commerce backend lib/commerce talks to: "shopify" | "mock"
# Use "mock" for local dev and CI so no Shopify credentials are required.
COMMERCE_PROVIDER=mock

# --- Shopify --------------------------------------------------------------
# Store domain. Not a secret. Live store: sgu8sy-at.myshopify.com
SHOPIFY_STORE_DOMAIN=sgu8sy-at.myshopify.com
# Storefront API public access token — read-only, used for catalogue + cart
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
# Admin API access token (shpat_...) — SERVER ONLY, full read/write access
SHOPIFY_ADMIN_ACCESS_TOKEN=
# Shopify API version pinned by both clients, e.g. 2026-07
SHOPIFY_API_VERSION=
# Shared secret used to verify inbound Shopify webhook HMAC signatures
SHOPIFY_WEBHOOK_SECRET=

# Store defaults (not secrets) — currency NZD, timezone Pacific/Auckland
NEXT_PUBLIC_STORE_CURRENCY=NZD
NEXT_PUBLIC_STORE_TIMEZONE=Pacific/Auckland

# --- Supabase -------------------------------------------------------------
# Project REST URL, e.g. https://abcdefghijklm.supabase.co (browser-safe)
NEXT_PUBLIC_SUPABASE_URL=
# Publishable / anon key — browser-safe, protected by row level security
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — SERVER ONLY, bypasses RLS. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection string, used by migrations and seed scripts
SUPABASE_DB_URL=

# --- Anthropic ------------------------------------------------------------
# API key (sk-ant-...) for the agent layer in lib/agents — SERVER ONLY
ANTHROPIC_API_KEY=
# Optional model override, e.g. claude-opus-4-5
ANTHROPIC_MODEL=

# --- Inngest --------------------------------------------------------------
# Event key used to send events to Inngest — SERVER ONLY
INNGEST_EVENT_KEY=
# Signing key used to verify inbound requests from Inngest — SERVER ONLY
INNGEST_SIGNING_KEY=

# --- Admin auth -----------------------------------------------------------
# Hash of the admin password (bcrypt/argon2). Store the HASH, never the
# plaintext password. Generate locally and paste the hash only.
ADMIN_PASSWORD_HASH=
# Secret used to sign the admin session cookie (32+ random bytes, base64)
ADMIN_SESSION_SECRET=
