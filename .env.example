# ---------------------------------------------------------------------------
# HALF SOUR — environment variables
#
# Copy to `.env.local` and fill in. NEVER commit real values: `.env*` is
# gitignored (this example file is the single opt-in exception).
# In production these are set in the Vercel project's Environment Variables.
# ---------------------------------------------------------------------------

# --- Supabase -------------------------------------------------------------
# Project REST URL, e.g. https://abcdefghijklm.supabase.co  (safe for browser)
NEXT_PUBLIC_SUPABASE_URL=
# Publishable / anon key — browser-safe, RLS-protected
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role (secret) key — SERVER ONLY, bypasses RLS. Never expose it.
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection string, used by migrations / seed scripts
SUPABASE_DB_URL=

# --- Shopify --------------------------------------------------------------
# Store domain, e.g. half-sour.myshopify.com  (safe for browser)
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=
# Storefront API public access token — read-only, browser-safe
NEXT_PUBLIC_SHOPIFY_STOREFRONT_ACCESS_TOKEN=
# Admin API access token (shpat_...) — SERVER ONLY, full write access
SHOPIFY_ADMIN_ACCESS_TOKEN=
# Admin API version pinned by the client, e.g. 2026-07
SHOPIFY_ADMIN_API_VERSION=
# Shared secret used to verify inbound Shopify webhook HMAC signatures
SHOPIFY_WEBHOOK_SECRET=

# --- Anthropic ------------------------------------------------------------
# API key (sk-ant-...) for the agent layer in lib/agents — SERVER ONLY
ANTHROPIC_API_KEY=
# Optional model override, e.g. claude-opus-4-5
ANTHROPIC_MODEL=

# --- Inngest --------------------------------------------------------------
# Event key used to send events to Inngest — SERVER ONLY
INNGEST_EVENT_KEY=
# Signing key used to verify inbound Inngest requests — SERVER ONLY
INNGEST_SIGNING_KEY=

# --- Admin auth -----------------------------------------------------------
# bcrypt/argon2 hash of the admin password. Store the HASH, never the password.
ADMIN_PASSWORD_HASH=
# Secret used to sign the admin session cookie (32+ random bytes, base64)
ADMIN_SESSION_SECRET=

# --- Site -----------------------------------------------------------------
# Canonical public origin, e.g. https://halfsour.com (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
