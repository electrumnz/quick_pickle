# ---------------------------------------------------------------------------
# QUICK PICKLE: environment variables
#
# Copy to `.env.local` and fill in. NEVER commit real values: `.env` / `.env.*`
# are gitignored and this example file is the single opt-in exception.
# In production these are Vercel Project Environment Variables.
#
# Nothing here is required to run the site. With every line unset it builds,
# serves, takes test orders, charges nobody, and runs its back end on demo
# data in memory.
# ---------------------------------------------------------------------------

# Canonical public origin, no trailing slash (e.g. https://quickpickle.co.nz).
# Unset, it falls back to the Vercel domain, then to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Which payment processor the checkout uses. "test" (the default) records the
# order and moves no money, and every checkout screen says so. A real
# processor is added in lib/shop/payments/index.ts; an unknown name here is a
# hard failure, never a silent fall back to test mode.
PAYMENT_PROVIDER=test

# Where the shop hands orders and Pickle Crew sign-ups over.
#   db    the default: the back end's database, through its own operations.
#   file  appends JSON lines under .data/ (gitignored).
#   log   one structured line to the server log, nothing kept.
ORDER_STORE=

# --- The database -----------------------------------------------------------
# A Postgres connection string. In production this is Supabase's transaction
# pooler URI. POSTGRES_URL (what the Vercel and Supabase integration writes) is
# read too. With neither set the app runs on Postgres in the same process
# (PGlite): in memory for tests and deployments, under .data/pglite in
# development, and the back end runs in demo mode.
DATABASE_URL=

# The database provider's CA certificate (PEM). With it the server is verified
# properly; without it the link is encrypted but the server is not proven.
DATABASE_CA_CERT=

# A Vercel preview deployment ignores the database unless this is "1".
# Previews run unmerged code and take test orders. Leave it unset.
QP_PREVIEW_DATABASE=

# "memory" keeps the in-process database in memory even in development.
# The browser tests use it.
QP_EMBEDDED_DB=

# --- The back end -----------------------------------------------------------
# A phrase of 16 characters or more. It is typed once, on /backstage/set-up,
# to create the first owner. After that it does nothing.
BACKSTAGE_SETUP_CODE=

# "required" makes the in-process database behave as a real one: sign-in is
# enforced. For tests and for trying the sign-in screens locally.
BACKSTAGE_AUTH=

# --- Payments ---------------------------------------------------------------
# Which processor takes the money. Unset or "test": the checkout records the
# order and charges nobody. "stripe": Stripe's hosted payment page.
# PAYMENT_PROVIDER=stripe
# Stripe's secret key. A test key (sk_test_) means Stripe's test mode.
# STRIPE_SECRET_KEY=
# The signing secret of the webhook endpoint that points at
# /api/stripe/webhook. Without it that endpoint refuses everything.
# STRIPE_WEBHOOK_SECRET=

# --- Email ------------------------------------------------------------------
# Who sends email: an order's own (its receipt, on the courier, cancelled, a
# payment on its way back) and a reply written in the inbox. Unset or "off":
# nothing is sent, and each email is written down with the reason. "resend":
# Resend's HTTP API. Any other name is a hard failure, never a quiet fall
# back to "off".
#
# Email only ever leaves a production deployment with a real database. A
# preview, a development server, a test and a back end on demo data all write
# their emails down and send nothing, whatever is set here.
# MAIL_PROVIDER=resend
# Resend's API key (re_...). Sending needs it. It is never logged or stored.
# RESEND_API_KEY=
# The address emails are sent from, on a domain verified with Resend. Replies
# come back to it, so it has to be one somebody reads, or one whose mail
# arrives in the inbox (below).
# MAIL_FROM=hello@example.co.nz

# --- The inbox --------------------------------------------------------------
# The signing secret (whsec_...) of the webhook Resend calls at
# /api/mail/resend: mail it has received for us, and what became of mail we
# sent (delivered, bounced, marked as spam). Unset, that address lets nobody
# in: no mail arrives in the inbox by itself, and a bounce or a complaint is
# not heard.
# RESEND_WEBHOOK_SECRET=
# The key each email's own reply address is signed with, sixteen characters
# or more (openssl rand -hex 32). Set it only once mail for the sending
# domain arrives here: a reply then finds its conversation wherever it has
# been moved. Unset, replies come to MAIL_FROM and are matched by what they
# answer. It is only used while one of the two ways in is open.
# MAIL_TOKEN_SECRET=
# For a mail forwarder of our own (a Cloudflare Email Worker, say) that posts
# raw email to /api/mail/inbound with Authorization: Bearer <this>. Sixteen
# characters or more. Not needed when Resend receives the mail.
# MAIL_INBOUND_SECRET=

# --- The clock --------------------------------------------------------------
# What a caller has to say to /api/tick (Authorization: Bearer ...). Sixteen
# characters or more. Unset, the endpoint lets nobody in. In production the
# infra workflow's connect-clock makes it and gives the database the same one.
# CRON_SECRET=
