# ---------------------------------------------------------------------------
# HALF SOUR — environment variables
#
# Copy to `.env.local` and fill in. NEVER commit real values: `.env` / `.env.*`
# are gitignored and this example file is the single opt-in exception.
# In production these are set as Vercel Project Environment Variables.
# ---------------------------------------------------------------------------

# --- Site -----------------------------------------------------------------
# Canonical public origin, no trailing slash (e.g. https://halfsour.co.nz)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Commerce adapter -----------------------------------------------------
# Which commerce backend lib/commerce talks to: "shopify" | "mock"
# Use "mock" for local dev and CI so no Shopify credentials are required.
COMMERCE_PROVIDER=mock

# --- Shopify --------------------------------------------------------------
# Store domain, e.g. your-store.myshopify.com. Not a secret, but the real
# value is a deployment detail: it lives in the Vercel project environment
# variables (all targets) and in your local .env.local, never in this file.
SHOPIFY_STORE_DOMAIN=
# Storefront API public access token — read-only, used for catalogue + cart
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
# Admin API access token (shpat_...) — SERVER ONLY, full read/write access
SHOPIFY_ADMIN_ACCESS_TOKEN=
# Shopify API version pinned by both clients, e.g. 2026-07
SHOPIFY_API_VERSION=
# Shared secret used to verify inbound Shopify webhook HMAC signatures
SHOPIFY_WEBHOOK_SECRET=

# Store defaults (not secrets) — currency NZD, timezone Pacific/Auckland
NEXT_PUBLIC_STORE_CURRENCY=NZD
NEXT_PUBLIC_STORE_TIMEZONE=Pacific/Auckland

# --- Supabase -------------------------------------------------------------
# Project REST URL, e.g. https://abcdefghijklm.supabase.co (browser-safe)
NEXT_PUBLIC_SUPABASE_URL=
# Publishable / anon key — browser-safe, protected by row level security
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — SERVER ONLY, bypasses RLS. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection string, used by migrations and seed scripts
SUPABASE_DB_URL=

# --- Anthropic ------------------------------------------------------------
# API key (sk-ant-...) for the agent layer in lib/agents — SERVER ONLY
ANTHROPIC_API_KEY=
# Optional model override, e.g. claude-opus-4-5
ANTHROPIC_MODEL=

# --- Inngest --------------------------------------------------------------
# Event key used to send events to Inngest — SERVER ONLY
INNGEST_EVENT_KEY=
# Signing key used to verify inbound requests from Inngest — SERVER ONLY
INNGEST_SIGNING_KEY=

# --- Admin auth -----------------------------------------------------------
# See lib/auth/README.md. The admin gate fails closed: if any of the three
# required values below is missing, sign-in is refused rather than degraded.
#
# argon2id PHC string for the admin password, e.g.
#   $argon2id$v=19$m=19456,t=2,p=1$<salt>$<digest>
# Generate with `npm run auth:hash-password` (prompts with echo off, or reads
# stdin). Store the HASH only: the plaintext belongs in a password manager and
# nowhere else, and the hash is deliberately NOT kept in the database so that a
# database dump contains nothing crackable.
ADMIN_PASSWORD_HASH=
# Root key the admin session and CSRF cookies are sealed under. 32+ random
# bytes, base64. Generate with `npm run auth:new-session-secret`.
# Rotating this signs everyone out immediately — the emergency lever behind
# per-session revocation.
ADMIN_SESSION_SECRET=
# Optional. Identity recorded on the founder's `operators` row, which is created
# on first successful sign-in and is what `admin_sessions` rows hang off.
ADMIN_OPERATOR_EMAIL=
ADMIN_OPERATOR_NAME=
# Optional. Whether to believe X-Forwarded-For when identifying the client for
# the per-IP rate limit. Defaults to true in production and on Vercel, where the
# edge rewrites those headers. "false" anywhere the app is exposed directly.
ADMIN_TRUST_PROXY_HEADERS=
