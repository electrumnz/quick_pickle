# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# next.js
/.next/
/out/
/build

# testing
/coverage
/.lighthouseci
/playwright-report
/test-results
/blob-report
/playwright/.cache

# env files — never commit real values; .env.example is the opt-in exception
.env
.env.*
!.env.example

# misc
.DS_Store
*.pem
.idea
.vscode/*
!.vscode/extensions.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# agent run evidence (large, machine-generated)
.claude/god-of-war/runs/*/evidence/

# agent scratch
.tmpbench/

# python bytecode
__pycache__/
*.pyc

# stray orchestrator scratch
_shot.mjs
.shotcheck/
.tune.mjs

# agent scratch space
.scratch/

# generation working files
.gen/

# the marketing asset library's local storage (photos and video the founder
# uploads; never committed, never inside public/)
.assets/
