{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    // Node 22 runs .mts/.ts directly by stripping types, and an ESM
    // specifier must carry its real extension. `npm run demo:build-image`
    // is such a script and imports `../mode.ts`; without this tsc rejects
    // the one spelling Node accepts. Safe with `noEmit`, which is set.
    "allowImportingTsExtensions": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.mts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".scratch/next-home/types/**/*.ts",
    ".scratch/next-home/dev/types/**/*.ts",
    ".scratch/next-audit/types/**/*.ts",
    ".scratch/next-audit/dev/types/**/*.ts",
    ".scratch/next-a11y/types/**/*.ts",
    ".scratch/next-a11y/dev/types/**/*.ts",
    ".scratch/next-demo/types/**/*.ts",
    ".scratch/next-demo/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules", ".next", "out"]
}
